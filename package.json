{
  "name": "full-stack-online-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Modern distributed e-commerce platform",
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "cd server && python manage.py runserver 0.0.0.0:8000",
    "test": "npm --prefix client run test && (cd server && pytest)",
    "lint": "npm --prefix client run lint && (cd server && ruff check .)"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
