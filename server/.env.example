# Django Core
SECRET_KEY=django-insecure-change-me-in-production-must-be-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgres://shop_user:shop_password@localhost:5432/shop_db
POSTGRES_DB=shop_db
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Cache
REDIS_URL=redis://localhost:6379/0
OTP_TTL_SECONDS=120
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_RATE_LIMIT_MAX_ATTEMPTS=3

# Celery & RabbitMQ
CELERY_BROKER_URL=amqp://shop_user:shop_password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / MinIO Storage
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_password123
AWS_STORAGE_BUCKET_NAME=shop-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
