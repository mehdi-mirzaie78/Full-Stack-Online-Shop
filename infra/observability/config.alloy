logging {
  level = "warn"
}
discovery.docker "shop" {
  host = "tcp://docker-socket-proxy:2375"
  refresh_interval = "5s"
  filter {
    name = "label"
    values = ["observability.logs=true", "observability.scope=" + sys.env("OBS_LOG_SCOPE")]
  }
}
discovery.relabel "shop" {
  targets = discovery.docker.shop.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "server|client"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    target_label = "environment"
    replacement = "development"
  }
}
loki.source.docker "shop" {
  host = "tcp://docker-socket-proxy:2375"
  targets = discovery.relabel.shop.output
  refresh_interval = "5s"
  forward_to = [loki.process.safe.receiver]
}
loki.process "safe" {
  stage.json {
    expressions = { event = "event", level = "level", request_id = "request_id", trace_id = "trace_id", span_id = "span_id", method = "method", route = "route", status_code = "status_code", duration_ms = "duration_ms" }
    drop_malformed = true
  }
  // Fail closed even if template evaluation rejects missing fields or wrong types.
  stage.template {
    source = "safe"
    template = "DROP"
  }
  // Reconstruct; never persist original line, arbitrary strings, nested JSON or exceptions.
  stage.template {
    source = "safe"
    template = `{{ if and (regexMatch "^(http_request|database_unavailable|redis_unavailable|cache_mismatch|framework_log|request_failed|browser_error|unhandled_rejection|render_failed|preview_failed)$" .event) (regexMatch "^(DEBUG|INFO|WARNING|WARN|ERROR|CRITICAL)$" .level) }}{{ $d := dict "event" .event "level" (.level | default "") }}{{ if regexMatch "^[a-f0-9-]{36}$" (.request_id | default "") }}{{ $_ := set $d "request_id" (.request_id | default "") }}{{ end }}{{ if regexMatch "^[a-f0-9]{32}$" (.trace_id | default "") }}{{ $_ := set $d "trace_id" (.trace_id | default "") }}{{ end }}{{ if regexMatch "^[a-f0-9]{16}$" (.span_id | default "") }}{{ $_ := set $d "span_id" (.span_id | default "") }}{{ end }}{{ if regexMatch "^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$" (.method | default "") }}{{ $_ := set $d "method" (.method | default "") }}{{ end }}{{ if regexMatch "^(/|/?api/(health/(db/|redis/)?|schema/|docs/|redoc/)|unmatched)$" (.route | default "") }}{{ $_ := set $d "route" (.route | default "") }}{{ end }}{{ if regexMatch "^[1-5][0-9]{2}$" (.status_code | default "") }}{{ $_ := set $d "status_code" (atoi .status_code) }}{{ end }}{{ if regexMatch "^[0-9]{1,9}(\\.[0-9]{1,3})?$" (.duration_ms | default "") }}{{ $_ := set $d "duration_ms" (float64 .duration_ms) }}{{ end }}{{ toJson $d }}{{ else }}DROP{{ end }}`
  }
  stage.output {
    source = "safe"
  }
  stage.drop {
    expression = "^DROP$"
  }
  stage.label_keep {
    values = ["service", "environment"]
  }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
otelcol.receiver.otlp "local" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.filter.no_links.input]
  }
}
// Alloy cannot mutate link slices safely; reject linked spans rather than leak.
otelcol.processor.filter "no_links" {
  error_mode = "propagate"
  traces {
    span = [`Len(links) > 0`]
  }
  output {
    traces = [otelcol.processor.transform.safe.input]
  }
}
otelcol.processor.transform "safe" {
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name"])`,
      `set(attributes["service.name"], "unknown") where attributes["service.name"] != "django" and attributes["service.name"] != "next"`,
    ]
  }
  trace_statements {
    context = "scope"
    statements = [`set(name, "shop")`, `set(version, "")`, `keep_keys(attributes, [])`]
  }
  trace_statements {
    context = "span"
    statements = [
      `keep_keys(attributes, ["http.request.method", "http.route", "http.response.status_code", "request_id"])`,
      `set(attributes["http.route"], "unmatched") where not IsMatch(attributes["http.route"], "^(/|/?api/(health/(db/|redis/)?|schema/|docs/|redoc/)|unmatched)$")`,
      `set(attributes["http.request.method"], "OTHER") where not IsMatch(attributes["http.request.method"], "^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$")`,
      `delete_key(attributes, "request_id") where not IsMatch(attributes["request_id"], "^[a-f0-9-]{36}$")`,
      `delete_key(attributes, "http.response.status_code") where attributes["http.response.status_code"] < 100 or attributes["http.response.status_code"] > 599`,
      `set(name, attributes["http.route"])`,
      `set(status.message, "")`,
      `set(trace_state, "")`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [`keep_keys(attributes, [])`, `set(name, "event")`]
  }
  output {
    traces = [otelcol.processor.batch.local.input, otelcol.connector.spanmetrics.local.input]
  }
}
otelcol.processor.batch "local" {
  timeout = "1s"
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
otelcol.connector.spanmetrics "local" {
  metrics_flush_interval = "5s"
  histogram {
    explicit {
      buckets = ["5ms", "10ms", "25ms", "50ms", "100ms", "250ms", "500ms", "1s", "2s", "5s"]
    }
  }
  output {
    metrics = [otelcol.exporter.prometheus.local.input]
  }
}
otelcol.exporter.prometheus "local" {
  forward_to = [prometheus.remote_write.local.receiver]
}
prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
