# Django Core
SECRET_KEY=django-insecure-change-me-in-production-must-be-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgres://shop_user:shop_password@localhost:5432/shop_db
POSTGRES_DB=shop_db
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Cache
REDIS_URL=redis://localhost:6379/0
OTP_TTL_SECONDS=120
OTP_RATE_LIMIT_WINDOW_SECONDS=600
OTP_RATE_LIMIT_MAX_ATTEMPTS=3

# Celery & RabbitMQ
CELERY_BROKER_URL=amqp://shop_user:shop_password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / SeaweedFS Storage
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_password123
AWS_STORAGE_BUCKET_NAME=shop-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Docker infrastructure
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
RABBITMQ_DEFAULT_USER=shop_user
RABBITMQ_DEFAULT_PASS=shop_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
S3_IMAGE=chrislusf/seaweedfs@sha256:c2658820e763294a9e9de7b36c81e59b879e3459148351aee4e31a126ca64860
S3_PORT=9000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# S3 / SeaweedFS Media CDN / Public URL
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/shop-media

# Internationalization & Layout
NEXT_PUBLIC_DEFAULT_LOCALE=fa
NEXT_PUBLIC_DEFAULT_DIR=rtl

# Development application host ports
CLIENT_PORT=3000
SERVER_PORT=8000
